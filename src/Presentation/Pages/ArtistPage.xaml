<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Rok.Pages.ArtistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:Rok.Pages"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:common="using:Rok.Commons"
      xmlns:tracks="using:Rok.ViewModels.Track"
      xmlns:albums="using:Rok.ViewModels.Album"
      Loaded="ArtistPage_Loaded"
      SizeChanged="Page_SizeChanged"
      mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Background>
            <SolidColorBrush Color="{ThemeResource CardBackgroundFillColorDefault}" Opacity="{StaticResource HeaderBackgroundOpacity}" />
        </Grid.Background>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="HeaderLayoutStates">
                <VisualState x:Name="WideHeader" />
                <VisualState x:Name="NarrowHeader">
                    <VisualState.Setters>
                        <Setter Target="headerGrid.Padding" Value="12,8,12,8" />
                        <Setter Target="kickerText.Visibility" Value="Collapsed" />
                        <Setter Target="summaryText.Visibility" Value="Collapsed" />
                        <Setter Target="artistPicture.Width" Value="72" />
                        <Setter Target="artistPicture.Height" Value="72" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactHeader">
                    <VisualState.Setters>
                        <Setter Target="headerGrid.Padding" Value="12,8,12,8" />
                        <Setter Target="kickerText.Visibility" Value="Collapsed" />
                        <Setter Target="summaryText.Visibility" Value="Collapsed" />
                        <Setter Target="artistPicture.Width" Value="72" />
                        <Setter Target="artistPicture.Height" Value="72" />
                        <Setter Target="artistExtras.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Image x:Name="backdrop" Grid.RowSpan="2" Style="{StaticResource HeaderBackdropStyle}" Source="{x:Bind ViewModel.Backdrop,Mode=OneWay}" Stretch="UniformToFill" IsHitTestVisible="False" />

        <!-- Tint of the artist picture dominant color over the header -->
        <Border Opacity="0.18" IsHitTestVisible="False" Background="{x:Bind ViewModel.DominantColor, Mode=OneWay, Converter={StaticResource ColorToAccentBrushConverter}}" />

        <!-- Header -->
        <Grid x:Name="headerGrid" Padding="16,10,16,10" ColumnSpacing="{StaticResource SpacingMedium}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Picture -->
            <Grid VerticalAlignment="Top" Margin="0" Style="{StaticResource HeaderPictureGridStyle}">
                <common:PictureControl x:Name="artistPicture" Width="160" Height="160" Style="{StaticResource HeaderPictureStyle}" UseArtistFallback="True" Cover="{x:Bind ViewModel.Picture, Mode=OneWay}" />
                <Button x:Uid="selectPicture" Style="{StaticResource HeaderPictureSelectButtonStyle}" Command="{x:Bind ViewModel.SelectPictureCommand}" />
            </Grid>

            <!-- Infos -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                    <TextBlock x:Name="kickerText" x:Uid="artistKicker" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" CharacterSpacing="80" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <common:BadgeControl x:Uid="badgeNew" Visibility="{x:Bind ViewModel.IsNew, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" BadgeBackground="{StaticResource BadgeNewBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource HeaderTitleTextStyle}" Text="{x:Bind ViewModel.Artist.Name, Mode=OneWay}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />

                <StackPanel x:Name="artistExtras" Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}">
                    <Button Command="{x:Bind ViewModel.GenreOpenCommand}" Padding="10,2" CornerRadius="{StaticResource CornerRadiusMediumValue}" Visibility="{x:Bind ViewModel.HasGenre, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.GenreName, Mode=OneWay}" FontSize="{StaticResource FontSizeSmall}" />
                            <FontIcon Glyph="&#xE76C;" FontSize="10" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="·" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.ShowActiveYearsSeparator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Text="{x:Bind ViewModel.ActiveYears, Mode=OneWay}" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.HasActiveYears, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Image Height="12" VerticalAlignment="Center" Source="{x:Bind ViewModel.Artist.CountryCode, Mode=OneWay, Converter={StaticResource CountryCodeToImageSourceConverter}}" ToolTipService.ToolTip="{x:Bind ViewModel.CountryName, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasCountry, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock x:Name="summaryText" Text="{x:Bind ViewModel.HeaderSummary, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}" Margin="0,6,0,0">
                    <AppBarButton x:Uid="artistViewListen" Style="{StaticResource ListenAppBarButtonStyle}" Width="Auto" MinWidth="0" Command="{x:Bind ViewModel.ListenCommand}" />

                    <Button Command="{x:Bind ViewModel.ArtistFavoriteCommand}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ArtistFavoriteLabel, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind ViewModel.ArtistFavoriteLabel, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Data="{StaticResource HeartPath}" Fill="{x:Bind ViewModel.IsFavorite, Converter={StaticResource FavoriteToColorConverter}, Mode=OneWay}" Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock x:Uid="albumFavoriteText" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock x:Uid="albumAddToPlaylistText" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.Flyout>
                            <MenuFlyout x:Name="artistPlaylistFlyout" common:MenuFlyoutExtensions.PlaylistMenuService="{x:Bind ViewModel.PlaylistMenuService}" common:MenuFlyoutExtensions.ArtistId="{x:Bind ViewModel.Artist.Id, Mode=OneWay}" common:MenuFlyoutExtensions.FlattenPlaylistMenu="True" />
                        </Button.Flyout>
                    </Button>

                    <Button x:Uid="albumMoreButton">
                        <FontIcon Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem x:Uid="albumMenuEdit" Icon="Edit" Command="{x:Bind ViewModel.EditArtistCommand}" />
                                <MenuFlyoutItem x:Uid="albumMenuBiography" Icon="Library" Command="{x:Bind ViewModel.OpenBiographyCommand}" Visibility="{x:Bind ViewModel.Artist.Biography, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                <MenuFlyoutSubItem x:Uid="artistMenuLinks" Visibility="{x:Bind ViewModel.HasLinks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <MenuFlyoutSubItem.Icon>
                                        <FontIcon Glyph="&#xE71B;" />
                                    </MenuFlyoutSubItem.Icon>
                                    <MenuFlyoutItem x:Uid="listeningLinkWebSite" Command="{x:Bind ViewModel.OpenUrlCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Artist.OfficialSiteUrl, Mode=OneWay}" Visibility="{x:Bind ViewModel.Artist.OfficialSiteUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <MenuFlyoutItem x:Uid="listeningLinkLastFm" Command="{x:Bind ViewModel.OpenUrlCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Artist.LastFmUrl, Mode=OneWay}" Visibility="{x:Bind ViewModel.Artist.LastFmUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <MenuFlyoutItem x:Uid="listeningLinkWikipedia" Command="{x:Bind ViewModel.OpenUrlCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Artist.WikipediaUrl, Mode=OneWay}" Visibility="{x:Bind ViewModel.Artist.WikipediaUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <MenuFlyoutItem x:Uid="listeningLinkFacebook" Command="{x:Bind ViewModel.OpenUrlCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Artist.FacebookUrl, Mode=OneWay}" Visibility="{x:Bind ViewModel.Artist.FacebookUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <MenuFlyoutItem x:Uid="listeningLinkInstagram" Command="{x:Bind ViewModel.OpenUrlCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Artist.InstagramUrl, Mode=OneWay}" Visibility="{x:Bind ViewModel.Artist.InstagramUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <MenuFlyoutItem x:Uid="listeningLinkTwitter" Command="{x:Bind ViewModel.OpenUrlCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Artist.TwitterUrl, Mode=OneWay}" Visibility="{x:Bind ViewModel.Artist.TwitterUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <MenuFlyoutItem x:Uid="listeningLinkThreads" Command="{x:Bind ViewModel.OpenUrlCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Artist.ThreadsUrl, Mode=OneWay}" Visibility="{x:Bind ViewModel.Artist.ThreadsUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <MenuFlyoutItem x:Uid="listeningLinkTikTok" Command="{x:Bind ViewModel.OpenUrlCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Artist.TiktokUrl, Mode=OneWay}" Visibility="{x:Bind ViewModel.Artist.TiktokUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                    <MenuFlyoutItem x:Uid="listeningLinkYoutube" Command="{x:Bind ViewModel.OpenUrlCommand, Mode=OneWay}" CommandParameter="{x:Bind ViewModel.Artist.YoutubeUrl, Mode=OneWay}" Visibility="{x:Bind ViewModel.Artist.YoutubeUrl, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}" />
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Style="{StaticResource FileGridStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Pivot>
                <!-- Albums -->
                <PivotItem x:Uid="artistViewTabAlbums">
                    <Grid>
                    <common:GridViewExtended x:Name="grid" ItemsPanel="{StaticResource GridPanelTemplate}" ItemsSource="{x:Bind ViewModel.Albums}" ContainerContentChanging="grid_ContainerContentChanging" ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="albums:AlbumViewModel">
                                <Grid Style="{StaticResource MainGridCoverStyle}" PointerEntered="gridBottom_PointerEntered" PointerExited="gridBottom_PointerExited" Background="Transparent">
                                    <Grid.Resources>
                                        <Storyboard x:Key="ShowFavoriteButtonStoryboard">
                                            <DoubleAnimation Storyboard.TargetName="favoriteButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.6" />
                                        </Storyboard>
                                        <Storyboard x:Key="HideFavoriteButtonStoryboard">
                                            <DoubleAnimation Storyboard.TargetName="favoriteButton" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </Grid.Resources>

                                    <Border CornerRadius="{StaticResource CornerRadiusMediumValue}">
                                        <common:PictureControl Style="{StaticResource PictureCoverStyle}" Cover="{x:Bind Picture, Mode=OneWay}" x:Phase="2" PlayButtonVisibility="Visible" Command="{x:Bind ListenCommand}" />
                                    </Border>

                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Vertical" Spacing="{StaticResource SpacingXSmall}" Margin="{StaticResource CoverBadgeMargin}">
                                        <common:BadgeControl x:Uid="badgeLive" Visibility="{x:Bind IsLive, Converter={StaticResource BoolToVisibilityConverter}}" BadgeBackground="{StaticResource BadgeLiveBrush}"/>
                                        <common:BadgeControl x:Uid="badgeBestof" Visibility="{x:Bind IsBestOf, Converter={StaticResource BoolToVisibilityConverter}}" BadgeBackground="{StaticResource BadgeBestOfBrush}" />
                                        <common:BadgeControl x:Uid="badgeCompilation" Visibility="{x:Bind IsCompilation, Converter={StaticResource BoolToVisibilityConverter}}" BadgeBackground="{StaticResource BadgeCompilationBrush}" />
                                        <common:BadgeControl x:Uid="badgeNew" Visibility="{x:Bind ShowNewBadge, Converter={StaticResource BoolToVisibilityConverter}}" BadgeBackground="{StaticResource BadgeNewBrush}" />
                                    </StackPanel>

                                    <Grid x:Name="gridBottom" Style="{StaticResource GridCoverBottomStyle}" Background="{x:Bind DominantColor, Converter={StaticResource ColorToGradientBrushConverter}, Mode=OneWay}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{StaticResource GridBottomFirstRowHeight}" />
                                            <RowDefinition Height="{StaticResource GridBottomSecondRowHeight}" />
                                        </Grid.RowDefinitions>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="{StaticResource FavoriteButtonColumnWidth}" />
                                        </Grid.ColumnDefinitions>

                                        <HyperlinkButton Content="{x:Bind Album.Name}" x:Phase="0" Command="{x:Bind AlbumOpenCommand}" Style="{StaticResource GridCoverButtonStyle}" />
                                        <TextBlock x:Name="subTitle" Grid.Row="1" Style="{StaticResource GridCoverBottomSecondLineStyle}" Margin="{StaticResource CoverSubtitleMargin}" Text="{x:Bind SubTitle, Mode=OneWay}" Opacity="1" x:Phase="1" />

                                        <common:AnimatedButton x:Name="favoriteButton" x:Uid="albumFavoriteButton" Grid.Column="1" IsTabStop="False" HorizontalAlignment="Right" VerticalAlignment="Stretch" Opacity="{x:Bind IsFavorite, Converter={StaticResource BoolToOpacityConverter}, Mode=OneWay}" Icon="{StaticResource HeartPath}" Color="{x:Bind IsFavorite, Converter={StaticResource FavoriteToColorConverter}, Mode=OneWay}" Command="{x:Bind AlbumFavoriteCommand}" CommandParameter="{x:Bind IsFavorite, Converter={StaticResource BoolToInvertBoolConverter}, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </common:GridViewExtended>

                        <common:EmptyStateControl x:Uid="artistPageNoAlbums" Glyph="&#xE93C;"
                                                  Visibility="{x:Bind ViewModel.HasNoAlbums, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </PivotItem>

                <!-- Tracks-->
                <PivotItem x:Uid="artistViewTabTracks">
                    <Grid x:Name="tracks" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="{StaticResource GridHeaderTracksHeight}" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <!-- Grid headers -->
                        <Grid Style="{StaticResource HeaderTracksGridStyle}" Padding="8,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource GridHeaderTracksTitleColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource GridHeaderTracksAlbumColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource GridHeaderTracksDurationColumnWidth}" />
                                <ColumnDefinition Width="{StaticResource GridHeaderTracksScoreColumnWidth}" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Uid="gridHeaderTitle" Grid.Column="0" Style="{StaticResource GridHeaderTracksTextBlockStyle}" />
                            <TextBlock x:Uid="gridHeaderAlbum" Grid.Column="1" Margin="2,0,0,0" Style="{StaticResource GridHeaderTracksTextBlockStyle}" />
                            <TextBlock x:Uid="gridHeaderDuration" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,14,0" Style="{StaticResource GridHeaderTracksTextBlockStyle}" />
                            <TextBlock x:Uid="gridHeaderScore" Grid.Column="3" Style="{StaticResource GridHeaderTracksTextBlockStyle}" />
                        </Grid>

                        <ListView x:Name="tracksList" Grid.Row="1" ContainerContentChanging="tracksList_ContainerContentChanging" ItemsSource="{x:Bind ViewModel.Tracks}" ItemContainerStyle="{StaticResource TracksListViewItemStyle}" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="tracks:TrackViewModel">
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource GridHeaderTracksTitleColumnWidth}" />
                                            <ColumnDefinition Width="{StaticResource GridHeaderTracksAlbumColumnWidth}" />
                                            <ColumnDefinition Width="{StaticResource GridHeaderTracksDurationColumnWidth}" />
                                            <ColumnDefinition Width="{StaticResource GridHeaderTracksScoreColumnWidth}" />
                                        </Grid.ColumnDefinitions>

                                        <Grid.ContextFlyout>
                                            <MenuFlyout ShowMode="TransientWithDismissOnPointerMoveAway" common:MenuFlyoutExtensions.PlaylistMenuService="{x:Bind PlaylistMenuService}" common:MenuFlyoutExtensions.TrackId="{x:Bind Track.Id}">
                                                <MenuFlyoutItem x:Uid="trackFlyoutListen" Icon="Play" Command="{x:Bind ListenCommand}" CommandParameter="{x:Bind}" />
                                                <MenuFlyoutItem x:Uid="trackFlyoutArtist" Icon="People" Command="{x:Bind ArtistOpenCommand}" Visibility="Collapsed" />
                                                <MenuFlyoutItem x:Uid="trackFlyoutAlbum" Command="{x:Bind AlbumOpenCommand}" >
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xe93c;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem x:Uid="trackFlyoutTrack" Icon="Audio" Command="{x:Bind TrackOpenCommand}"/>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Uid="trackFlyoutLyrics" Command="{x:Bind LyricsOpenCommand}" Visibility="{x:Bind LyricsExists, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <MenuFlyoutItem.Icon>
                                                        <FontIcon Glyph="&#xE90B;" />
                                                    </MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock x:Name="RowIndexText" Style="{StaticResource GridTracksRowIndexTextBlockStyle}" />
                                            <HyperlinkButton Style="{StaticResource GridTracksTitleHyperlinkButtonStyle}" Command="{x:Bind ListenCommand}" CommandParameter="{x:Bind}" />
                                            <HyperlinkButton Visibility="{x:Bind LyricsType, Converter={StaticResource LyricsTypeVisibilityConverter}, ConverterParameter=Synchronized, Mode=OneWay}" Style="{StaticResource GridTracksSyncLyricsBadgeStyle}" Command="{x:Bind LyricsOpenCommand}" />
                                            <HyperlinkButton Visibility="{x:Bind LyricsType, Converter={StaticResource LyricsTypeVisibilityConverter}, ConverterParameter=Plain, Mode=OneWay}" Style="{StaticResource GridTracksPlainLyricsBadgeStyle}" Command="{x:Bind LyricsOpenCommand}" />
                                        </StackPanel>

                                        <HyperlinkButton Grid.Column="1" Style="{StaticResource GridTracksArtistHyperlinkButtonStyle}" Command="{x:Bind ArtistOpenCommand}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind DurationStr}" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <common:RatingControlLightControl Grid.Column="3" Style="{StaticResource GridTracksScoreStyle}" RatingValue="{x:Bind Score, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <common:EmptyStateControl x:Uid="artistPageNoTracks" Glyph="&#xE8D6;" Grid.Row="1"
                                                  Visibility="{x:Bind ViewModel.HasNoTracks, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </Grid>
                </PivotItem>
            </Pivot>

            <common:EmptyStateControl x:Uid="artistPageNotFound" Glyph="&#xE783;"
                                      Visibility="{x:Bind ViewModel.IsNotFound, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Listening statistics panel -->
            <common:ListeningStatsPanel x:Name="statsPanel" x:Uid="artistStatsPanel" Grid.Column="1" Width="250" Margin="0,8,12,12"
                                        Stats="{x:Bind ViewModel.ListeningStats, Mode=OneWay}"
                                        AccentBrush="{x:Bind ViewModel.DominantColor, Mode=OneWay, Converter={StaticResource ColorToAccentBrushConverter}}" />
        </Grid>
    </Grid>
</Page>
