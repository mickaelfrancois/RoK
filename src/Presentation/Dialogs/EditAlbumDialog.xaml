<ContentDialog x:Class="Rok.Dialogs.EditAlbumDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="using:Rok.Dialogs"
               x:Uid="EditAlbumDialog"
               Title=""
               MinWidth="900"
               MaxWidth="900"
               Width="900"
               PrimaryButtonText=""
               CloseButtonText="">

    <StackPanel>
        <StackPanel x:Name="TaggedPanel"
                    Spacing="8"
                    Margin="0,0,0,8">
            <TextBox x:Uid="albumNameInput"
                     x:Name="NameInput"
                     Header=""
                     TextChanged="Input_TextChanged" />

            <AutoSuggestBox x:Uid="albumArtistInput"
                            x:Name="ArtistInput"
                            Header=""
                            TextChanged="ArtistInput_TextChanged" />

            <StackPanel Orientation="Horizontal"
                        Spacing="16">
                <TextBox x:Uid="albumYearInput"
                         x:Name="YearInput"
                         Header=""
                         Width="180"
                         TextChanged="Input_TextChanged" />
                <AutoSuggestBox x:Uid="albumGenreInput"
                                x:Name="GenreInput"
                                Header=""
                                Width="400"
                                TextChanged="GenreInput_TextChanged" />
            </StackPanel>

            <TextBlock x:Uid="albumGenreLockedNote"
                       x:Name="GenreLockedNote"
                       Visibility="Collapsed"
                       TextWrapping="Wrap"
                       Style="{StaticResource CaptionTextBlockStyle}" />

            <InfoBar x:Name="ErrorBar"
                     Severity="Error"
                     IsOpen="False"
                     IsClosable="False" />

            <MenuFlyoutSeparator></MenuFlyoutSeparator>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <ToggleSwitch x:Uid="liveSwitch"
                          IsOn="{x:Bind IsLive, Mode=TwoWay}"></ToggleSwitch>
            <ToggleSwitch x:Uid="bestOfSwitch"
                          IsOn="{x:Bind IsBestOf, Mode=TwoWay}"></ToggleSwitch>
            <ToggleSwitch x:Uid="compilationSwitch"
                          IsOn="{x:Bind IsCompilation, Mode=TwoWay}"></ToggleSwitch>
            <ToggleSwitch x:Uid="lockSwitch"
                          IsOn="{x:Bind IsLock, Mode=TwoWay}"></ToggleSwitch>
        </StackPanel>
        <MenuFlyoutSeparator></MenuFlyoutSeparator>

        <TextBlock x:Uid="musicBrainzId"
                   Margin="0,8,0,0"
                   Text="MusicBrainz ID"></TextBlock>
        <TextBox x:Uid="musicBrainzIdInput"
                 Text="{x:Bind MusicBrainzID, Mode=TwoWay}"
                 Margin="0,4,0,0"></TextBox>

        <TextBlock x:Uid="releaseGroupMusicBrainzId"
                   Margin="0,8,0,0"
                   Text="Release group MusicBrainz ID" />
        <TextBox x:Uid="releaseGroupMusicBrainzIdInput"
                 Text="{x:Bind ReleaseGroupMusicBrainzId, Mode=TwoWay}"
                 Margin="0,4,0,0" />

        <TextBlock x:Uid="lastFm"
                   Margin="0,8,0,0"
                   Text="LastFM URL" />
        <TextBox x:Uid="lastFmInput"
                 Text="{x:Bind LastFmUrl, Mode=TwoWay}"
                 Margin="0,4,0,0"></TextBox>

        <TextBlock x:Uid="biography"
                   Margin="0,8,0,0"
                   Text="Informations" />
        <TextBox x:Uid="biogrpahyInput"
                 Text="{x:Bind Biography, Mode=TwoWay}"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Height="200"
                 Width="600"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Margin="0,4,0,0"></TextBox>

    </StackPanel>
</ContentDialog>