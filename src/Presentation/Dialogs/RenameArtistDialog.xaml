<ContentDialog x:Class="Rok.Dialogs.RenameArtistDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Uid="RenameArtistDialog"
               Title=""
               MinWidth="560"
               PrimaryButtonText=""
               CloseButtonText=""
               DefaultButton="Close">

    <StackPanel Spacing="12">
        <TextBlock x:Name="SummaryText"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextWrapping="Wrap"
                   IsTextSelectionEnabled="True" />

        <TextBlock x:Name="CountsText"
                   TextWrapping="Wrap" />

        <TextBlock x:Name="DetailHeader"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <ScrollViewer x:Name="DetailScroll"
                      MaxHeight="240"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="Collapsed">
            <ItemsControl x:Name="DetailList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="ProgressPanel"
                    Spacing="4"
                    Visibility="Collapsed">
            <ProgressBar x:Name="RenameProgress"
                         Minimum="0"
                         Maximum="1"
                         Value="0"
                         IsIndeterminate="True" />
            <TextBlock x:Name="ProgressText" />
        </StackPanel>

        <InfoBar x:Name="ErrorBar"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="False" />
    </StackPanel>
</ContentDialog>