<ContentDialog x:Class="Rok.Dialogs.EditTrackTitleDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               x:Uid="EditTrackTitleDialog"
               Title=""
               MinWidth="520"
               PrimaryButtonText=""
               CloseButtonText=""
               DefaultButton="Primary"
               IsPrimaryButtonEnabled="False">

    <StackPanel Spacing="12">
        <TextBox x:Uid="EditTrackTitleInput"
                 x:Name="TitleInput"
                 Header=""
                 Text="{x:Bind Candidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <StackPanel Spacing="2">
            <TextBlock x:Uid="EditTrackTitlePreviewLabel"
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="PreviewText"
                       TextWrapping="Wrap" />
        </StackPanel>

        <InfoBar x:Name="ErrorBar"
                 Severity="Error"
                 IsOpen="False"
                 IsClosable="False" />
    </StackPanel>
</ContentDialog>