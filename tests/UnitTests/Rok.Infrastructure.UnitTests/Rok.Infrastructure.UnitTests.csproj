		<Compile Include="..\..\..\tools\Rok.MetadataTool\MixPointStats.cs" Link="Tools\MixPointStats.cs" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<None Update="TestData\Playlists\*.m3u*">
